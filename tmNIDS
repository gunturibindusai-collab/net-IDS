# Test 1: Linux UID over HTTP
# ET Rule: GPL ATTACK_RESPONSE id check returned root (SID: 2100498)
test_uid() {
  print_header "1" "$test_uid_name" "HTTP"
  local base_url
  base_url="$(get_base_url)"
  local target_url="${base_url}/uid/index.html"

  echo -e "Target: ${COLOR_BOLD}$target_url${COLOR_RESET}"
  local response
  response="$(curl -s -m "$TMNIDS_TIMEOUT" "$target_url" 2>&1)"
  local exit_code=$?

  if [ $exit_code -eq 0 ]; then
    print_result "SUCCESS" "HTTP GET $target_url returned $(echo "$response" | head -n 1 | cut -c 1-50)..."
  else
    print_result "FAIL" "HTTP GET $target_url failed (exit code $exit_code). Target may be unreachable or offline."
  fi
}

# Test 2: Basic Authentication over Cleartext HTTP
# ET Rule: ET POLICY Cleartext Basic Auth with root credentials (SID: 2003195)
test_basicauth() {
  print_header "2" "$test_basicauth_name" "HTTP"
  local base_url
  base_url="$(get_base_url)"
  local target_url="${base_url}/"

  echo -e "Target: ${COLOR_BOLD}$target_url${COLOR_RESET} with Header 'Authorization: Basic cm9vdDpyb290' (root:root)"
  curl -s -m "$TMNIDS_TIMEOUT" -H "Authorization: Basic cm9vdDpyb290" "$target_url" > /dev/null 2>&1
  local exit_code=$?

  if [ $exit_code -eq 0 ]; then
    print_result "SUCCESS" "Sent Basic Auth header 'cm9vdDpyb290' to $target_url"
  else
    print_result "FAIL" "Failed to send HTTP request to $target_url (exit code $exit_code)"
  fi
}

# Test 3: Known Malware-related HTTP User-Agents
# ET Rules: ET MALWARE Suspicious User-Agent (SIDs: 2008983, 2003158, 2003056, 2006380)
test_useragent() {
  print_header "3" "$test_useragent_name" "HTTP"
  local base_url
  base_url="$(get_base_url)"
  local target_url="${base_url}/"
  local user_agents=("BlackSun" "HttpDownload" "agent" "MSIE" "JEDI-VCL")
  local success_count=0

  for ua in "${user_agents[@]}"; do
    echo -e "Sending User-Agent: ${COLOR_BOLD}$ua${COLOR_RESET}"
    if curl -s -m "$TMNIDS_TIMEOUT" -A "$ua" "$target_url" > /dev/null 2>&1; then
      ((success_count++))
    fi
  done

  if [ $success_count -gt 0 ]; then
    print_result "SUCCESS" "Sent $success_count/${#user_agents[@]} malicious User-Agent requests to $target_url"
  else
    print_result "FAIL" "Could not connect to $target_url to deliver User-Agent headers"
  fi
}

# Test 4: Known Bad CAs & Certificates
# SIDs: 2022134, 2020493, 2029345, 2033098, 2045597, 2053979, 2054198, 2021941
test_badcas_certs() {
  print_header "4" "$test_badcas_certs_name" "TLS, DNS, TCP"
  local base_url
  base_url="$(get_base_url)"

  echo -e "Probing known bad certificate test endpoints (eDellRoot, Superfish, ZAP)..."
  curl -s -m "$TMNIDS_TIMEOUT" https://edellroot.badssl.com/ > /dev/null 2>&1 || true # sid: 2022134
  curl -s -m "$TMNIDS_TIMEOUT" https://superfish.badssl.com/ > /dev/null 2>&1 || true # sid: 2020493

  # TLS connection simulations via openssl s_client with Server Name Indication (SNI)
  echo Q | timeout "$TMNIDS_TIMEOUT" openssl s_client -showcerts -servername example.livehost.live -connect example.livehost.live:443 > /dev/null 2>&1 || true
  echo Q | timeout "$TMNIDS_TIMEOUT" openssl s_client -showcerts -servername analiticsweb.site -connect analiticsweb.site:443 > /dev/null 2>&1 || true
  echo Q | timeout "$TMNIDS_TIMEOUT" openssl s_client -showcerts -servername adguard.clroot.io -connect adguard.clroot.io:443 > /dev/null 2>&1 || true
  echo Q | timeout "$TMNIDS_TIMEOUT" openssl s_client -showcerts -servername cryptpad.disroot.org -connect cryptpad.disroot.org:443 > /dev/null 2>&1 || true
  echo Q | timeout "$TMNIDS_TIMEOUT" openssl s_client -showcerts -servername beetrootculture.com -connect beetrootculture.com:443 > /dev/null 2>&1 || true

  # Test certificate content indicator (OWASP ZAP Certificate content sid: 2021941)
  curl -s -m "$TMNIDS_TIMEOUT" "${base_url}/content_for_tests/2021941.txt" > /dev/null 2>&1 || true

  print_result "SUCCESS" "Generated TLS/HTTPS handshakes with bad CA SNIs and test certificate content"
}

# Test 5: Tor .onion DNS response & Random Tor nodes connection
test_tor() {
  print_header "5" "$test_tor_name" "DNS & TLS"
  echo -e "Querying DNS for .onion hostname..."
  dig a 3wzn5p2yiumh7akj.onion @8.8.8.8 +time=2 +tries=1 > /dev/null 2>&1 || true

  echo -e "Retrieving Tor public directory node list..."
  local tmp_tor="/tmp/tor_$$.list"
  local tmp_rand="/tmp/randomtor_$$.list"

  if curl -s -m "$TMNIDS_TIMEOUT" https://raw.githubusercontent.com/SecOps-Institute/Tor-IP-Addresses/master/tor-nodes.lst -o "$tmp_tor" 2>/dev/null && [ -s "$tmp_tor" ]; then
    sort --random-sort "$tmp_tor" > "$tmp_rand" 2>/dev/null || shuf "$tmp_tor" -o "$tmp_rand" 2>/dev/null || cp "$tmp_tor" "$tmp_rand"
    echo -e "Probing up to 5 Tor directory nodes on port 443..."
    head -n 5 "$tmp_rand" | while read -r line; do
      [ -n "$line" ] && nc -z -w 2 "$line" 443 > /dev/null 2>&1 || true
    done
    rm -f "$tmp_tor" "$tmp_rand"
    print_result "SUCCESS" "Simulated Tor .onion DNS lookup and connected to active Tor relay nodes"
  else
    rm -f "$tmp_tor" "$tmp_rand"
    print_result "WARN" "External Tor node list unreachable; executed .onion DNS query only"
  fi
}

# Test 6: EXE Download over HTTP & Packed Executable
# SIDs: 2014520, 2000419
test_exe() {
  print_header "6" "$test_exe_name" "HTTP"
  local base_url
  base_url="$(get_base_url)"
  local target_url="${base_url}/exe/calc.exe"
  local tmp_dest="/tmp/calc_$$.exe"

  echo -e "Downloading test executable from: ${COLOR_BOLD}$target_url${COLOR_RESET}"
  if curl -s -m "$TMNIDS_TIMEOUT" "$target_url" -o "$tmp_dest" 2>/dev/null && [ -s "$tmp_dest" ]; then
    local size
    size="$(wc -c < "$tmp_dest")"
    rm -f "$tmp_dest"
    print_result "SUCCESS" "Downloaded $size bytes from $target_url (PE / Packed executable indicator)"
  else
    rm -f "$tmp_dest"
    print_result "FAIL" "Could not download executable from $target_url"
  fi
}

