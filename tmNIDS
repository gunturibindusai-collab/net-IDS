# ------------------------------------------------------------------------------
# Script Mode vs Interactive Mode
# ------------------------------------------------------------------------------

run_interactive_menu() {
  check_dependencies

  local options=(
    "$test_uid_name"
    "$test_basicauth_name"
    "$test_useragent_name"
    "$test_badcas_certs_name"
    "$test_tor_name"
    "$test_exe_name"
    "$test_pdf_name"
    "$test_22scan_name"
    "$test_miscdns_name"
    "$test_filesharing_name"
    "$test_external_ip_lookup_name"
    "$test_url_shortener_name"
    "$test_gaming_name"
    "$test_adware_pup_name"
    "$test_malware_c2_beacon_name"
    "CHAOS! RUN ALL!"
    "Quit!"
  )

  while true; do
    display_banner
    echo "Choose which test you'd like to run: "
    echo ""
    select opt in "${options[@]}"; do
      case $REPLY in
        1) test_uid; break ;;
        2) test_basicauth; break ;;
        3) test_useragent; break ;;
        4) test_badcas_certs; break ;;
        5) test_tor; break ;;
        6) test_exe; break ;;
        7) test_pdf; break ;;
        8) test_22scan; break ;;
        9) test_miscdns; break ;;
        10) test_filesharing; break ;;
        11) test_external_ip_lookup; break ;;
        12) test_url_shortener; break ;;
        13) test_gaming; break ;;
        14) test_adware_pup; break ;;
        15) test_malware_c2_beacon; break ;;
        16) test_all; break ;;
        17) echo "Exiting tmNIDS."; exit 0 ;;
        *) echo "Invalid option!" >&2
      esac
    done

    echo ""
    read -r -p "Press [Enter] to return to the menu..."
  done
}

# If no arguments provided, launch interactive menu
if [ -z "$*" ]; then
  run_interactive_menu
fi

# Script Mode (Arguments passed)
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--target)
      target_val="$2"
      shift
      if [[ "$target_val" =~ ^(https?)://(.*)$ ]]; then
        TMNIDS_TARGET_PROTO="${BASH_REMATCH[1]}"
        target_val="${BASH_REMATCH[2]}"
      fi
      if [[ "$target_val" =~ ^(.*):([0-9]+)$ ]]; then
        TMNIDS_TARGET_HOST="${BASH_REMATCH[1]}"
        TMNIDS_TARGET_PORT="${BASH_REMATCH[2]}"
      else
        TMNIDS_TARGET_HOST="$target_val"
      fi
      ;;
    --check-deps)
      check_dependencies
      exit $?
      ;;
    -l|--list|-h|--help)
      display_help
      exit 0
      ;;
    -i|--interactive)
      run_interactive_menu
      exit 0
      ;;
    -1) test_uid ;;
    -2) test_basicauth ;;
    -3) test_useragent ;;
    -4) test_badcas_certs ;;
    -5) test_tor ;;
    -6) test_exe ;;
    -7) test_pdf ;;
    -8) test_22scan ;;
    -9) test_miscdns ;;
    -10) test_filesharing ;;
    -11) test_external_ip_lookup ;;
    -12) test_url_shortener ;;
    -13) test_gaming ;;
    -14) test_adware_pup ;;
    -15) test_malware_c2_beacon ;;
    -99) test_all ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Use -h or --help for available options." >&2
      exit 1
      ;;
  esac
  shift
done

