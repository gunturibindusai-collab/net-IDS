# Set strict shell options where appropriate (avoid exiting entirely on single test failure)
set -o pipefail

# ------------------------------------------------------------------------------
# Configuration & Defaults
# ------------------------------------------------------------------------------
TMNIDS_VERSION="2.1.0-replica"
DEFAULT_TARGET_HOST="testmynids.org"
DEFAULT_TARGET_PORT="80"
DEFAULT_TARGET_PROTO="http"

# Allow environment overrides
TMNIDS_TARGET_HOST="${TMNIDS_TARGET_HOST:-$DEFAULT_TARGET_HOST}"
TMNIDS_TARGET_PORT="${TMNIDS_TARGET_PORT:-$DEFAULT_TARGET_PORT}"
TMNIDS_TARGET_PROTO="${TMNIDS_TARGET_PROTO:-$DEFAULT_TARGET_PROTO}"
TMNIDS_LOG_FILE="${TMNIDS_LOG_FILE:-tmnids_run.log}"
TMNIDS_TIMEOUT="${TMNIDS_TIMEOUT:-5}"

# ANSI Colors
COLOR_RESET="\033[0m"
COLOR_BOLD="\033[1m"
COLOR_RED="\033[31m"
COLOR_GREEN="\033[32m"
COLOR_YELLOW="\033[33m"
COLOR_BLUE="\033[34m"
COLOR_CYAN="\033[36m"
COLOR_GRAY="\033[90m"

# ------------------------------------------------------------------------------
# Test Names (Faithfully preserved from original tmNIDS)
# ------------------------------------------------------------------------------
test_uid_name="Linux UID"
test_basicauth_name="HTTP Basic Authentication"
test_useragent_name="HTTP Malware User-Agent"
test_badcas_certs_name="Bad Certificates & CAs"
test_tor_name="Tor .onion DNS response and known IPs connection"
test_exe_name="EXE or DLL download over HTTP"
test_pdf_name="PDF download with Embedded File"
test_22scan_name="Simulate SSH Outbound Scan"
test_miscdns_name="Miscellaneous domains (TLD's, Sinkhole, DDNS, etc)"
test_filesharing_name="Anonymous filesharing website"
test_external_ip_lookup_name="External IP Address Lookup"
test_url_shortener_name="URL Shortener"
test_gaming_name="Policy Violation - Gaming"
test_adware_pup_name="Adware PUP"
test_malware_c2_beacon_name="Malware - Command & Control - Beacon"

# ------------------------------------------------------------------------------
# Logging & Helper Functions
# ------------------------------------------------------------------------------
log_msg() {
  local level="$1"
  local msg="$2"
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  echo -e "[$timestamp] [$level] $msg" >> "$TMNIDS_LOG_FILE"
}

print_header() {
  local id="$1"
  local name="$2"
  local proto="$3"
  echo -e "\n${COLOR_CYAN}=================================================================${COLOR_RESET}"
  echo -e "${COLOR_BOLD}[Test $id] $name${COLOR_RESET} ${COLOR_GRAY}(Protocol: $proto)${COLOR_RESET}"
  echo -e "${COLOR_CYAN}-----------------------------------------------------------------${COLOR_RESET}"
  log_msg "INFO" "Executing Test $id: $name (Protocol: $proto)"
}

print_result() {
  local status="$1"
  local details="$2"
  if [ "$status" == "SUCCESS" ]; then
    echo -e "${COLOR_GREEN}[+] Traffic Generated Successfully${COLOR_RESET}: $details"
    log_msg "SUCCESS" "$details"
  elif [ "$status" == "WARN" ]; then
    echo -e "${COLOR_YELLOW}[!] Warning / Partial Result${COLOR_RESET}: $details"
    log_msg "WARN" "$details"
  else
    echo -e "${COLOR_RED}[-] Failed / Unreachable${COLOR_RESET}: $details"
    log_msg "ERROR" "$details"
  fi
}

get_base_url() {
  if [ "$TMNIDS_TARGET_PORT" == "80" ] && [ "$TMNIDS_TARGET_PROTO" == "http" ]; then
    echo "${TMNIDS_TARGET_PROTO}://${TMNIDS_TARGET_HOST}"
  elif [ "$TMNIDS_TARGET_PORT" == "443" ] && [ "$TMNIDS_TARGET_PROTO" == "https" ]; then
    echo "${TMNIDS_TARGET_PROTO}://${TMNIDS_TARGET_HOST}"
  else
    echo "${TMNIDS_TARGET_PROTO}://${TMNIDS_TARGET_HOST}:${TMNIDS_TARGET_PORT}"
  fi
}

# ------------------------------------------------------------------------------
# Dependency Checking
# ------------------------------------------------------------------------------
check_dependencies() {
  local missing=()
  echo -e "${COLOR_BLUE}[*] Checking required tools...${COLOR_RESET}"

  for cmd in curl nc openssl dig; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  if [ ${#missing[@]} -ne 0 ]; then
    echo -e "${COLOR_YELLOW}[!] Warning: Missing recommended tool(s): ${missing[*]}${COLOR_RESET}"
    echo -e "    Some tests may fail or have reduced coverage."
    echo -e "    On Ubuntu/Debian/WSL, install them with:"
    echo -e "    ${COLOR_BOLD}sudo apt-get update && sudo apt-get install -y curl netcat-openbsd bind9-dnsutils openssl${COLOR_RESET}\n"
    log_msg "WARN" "Missing tools: ${missing[*]}"
    return 1
  else
    echo -e "${COLOR_GREEN}[+] All core dependencies available (curl, nc, openssl, dig).${COLOR_RESET}\n"
    log_msg "INFO" "All core dependencies verified"
    return 0
  fi
}

# ------------------------------------------------------------------------------
# Test Implementations
