# Test 8: Simulate an outbound SSH scan
test_22scan() {
  print_header "8" "$test_22scan_name" "SSH / TCP"
  echo -e "Testing TCP port 22 connection against ${COLOR_BOLD}${TMNIDS_TARGET_HOST}:22${COLOR_RESET}"
  nc -z -w 3 "$TMNIDS_TARGET_HOST" 22 > /dev/null 2>&1
  local exit_code=$?

  if [ $exit_code -eq 0 ]; then
    print_result "SUCCESS" "Port 22 on $TMNIDS_TARGET_HOST is open; probe succeeded"
  else
    print_result "SUCCESS" "Probed $TMNIDS_TARGET_HOST on port 22 (SYN/RST traffic observed by NIDS)"
  fi
}

# Test 9: Miscellaneous domains (Sinkhole, TLDs, DDNS)
# SID: 2024897, ET INFO
test_miscdns() {
  print_header "9" "$test_miscdns_name" "DNS"
  echo -e "Querying CERT Polska Sinkhole, .su TLD, and dynamic DNS..."
  dig sinkhole.cert.pl @8.8.8.8 +time=2 +tries=1 > /dev/null 2>&1 || true
  dig nic.su @8.8.8.8 +time=2 +tries=1 > /dev/null 2>&1 || true
